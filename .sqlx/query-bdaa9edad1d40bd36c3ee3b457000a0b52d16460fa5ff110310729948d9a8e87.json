  "query": "SELECT s.imdb, s.server, s.size, s.segment, s.start_time\nFROM segments s\nINNER JOIN movies m ON s.imdb = m.imdb AND s.server = m.server\nWHERE s.last_acces IS NOT NULL\nORDER BY\n    m.last_acces ASC,\n    s.last_acces ASC\nLIMIT ?;",
